{
  "valid_registration_ui": {
    "id": "FR01-TC01",
    "title": "valid registration reaches the login destination with compliant registration UI",
    "registrationPath": "/register",
    "fieldsToFill": [
      "fullName",
      "email",
      "password",
      "confirmationPassword"
    ],
    "input": {
      "fullName": "Nguyễn Văn An",
      "emailTemplate": "fr01-tc01-{{unique}}@example.test",
      "password": "ValidPass1!",
      "confirmationPassword": "ValidPass1!"
    },
    "expected": {
      "labels": {
        "heading": "Đăng ký tài khoản",
        "fullName": "Họ Tên",
        "email": "Email",
        "password": "Mật khẩu",
        "confirmationPassword": "Xác nhận mật khẩu",
        "submit": "Đăng ký"
      },
      "vietnameseContent": [
        "Đăng ký tài khoản",
        "Họ Tên",
        "Email",
        "Mật khẩu",
        "Xác nhận mật khẩu",
        "Đăng ký",
        "Đã có tài khoản?",
        "Đăng nhập"
      ],
      "loginDestination": {
        "heading": "Đăng nhập",
        "email": "Email",
        "password": "Mật khẩu",
        "submit": "Đăng nhập"
      }
    }
  },
  "required_field_omissions": {
    "id": "FR01-TC02",
    "title": "required controls reject blank and one-field omissions with correctly placed application errors",
    "registrationPath": "/register",
    "expected": {
      "labels": {
        "heading": "Đăng ký tài khoản",
        "fullName": "Họ Tên",
        "email": "Email",
        "password": "Mật khẩu",
        "confirmationPassword": "Xác nhận mật khẩu",
        "submit": "Đăng ký"
      },
      "requiredMarker": "*",
      "requiredFields": [
        "fullName",
        "email",
        "password",
        "confirmationPassword"
      ]
    },
    "variants": [
      {
        "name": "all_blank",
        "fieldsToFill": [],
        "omittedFields": [
          "fullName",
          "email",
          "password",
          "confirmationPassword"
        ],
        "input": {
          "fullName": "",
          "emailTemplate": "",
          "password": "",
          "confirmationPassword": ""
        }
      },
      {
        "name": "omit_full_name",
        "fieldsToFill": ["email", "password", "confirmationPassword"],
        "omittedFields": ["fullName"],
        "input": {
          "fullName": "",
          "emailTemplate": "fr01-tc02-name-{{unique}}@example.test",
          "password": "ValidPass1!",
          "confirmationPassword": "ValidPass1!"
        }
      },
      {
        "name": "omit_email",
        "fieldsToFill": ["fullName", "password", "confirmationPassword"],
        "omittedFields": ["email"],
        "input": {
          "fullName": "Nguyễn Văn An",
          "emailTemplate": "",
          "password": "ValidPass1!",
          "confirmationPassword": "ValidPass1!"
        }
      },
      {
        "name": "omit_password",
        "fieldsToFill": ["fullName", "email", "confirmationPassword"],
        "omittedFields": ["password"],
        "input": {
          "fullName": "Nguyễn Văn An",
          "emailTemplate": "fr01-tc02-password-{{unique}}@example.test",
          "password": "",
          "confirmationPassword": "ValidPass1!"
        }
      },
      {
        "name": "omit_confirmation_password",
        "fieldsToFill": ["fullName", "email", "password"],
        "omittedFields": ["confirmationPassword"],
        "input": {
          "fullName": "Nguyễn Văn An",
          "emailTemplate": "fr01-tc02-confirmation-{{unique}}@example.test",
          "password": "ValidPass1!",
          "confirmationPassword": ""
        }
      }
    ]
  },
  "email_format_partitions": {
    "id": "FR01-TC03",
    "title": "email control enforces invalid and valid format partitions without browser-specific wording",
    "registrationPath": "/register",
    "fieldsToFill": [
