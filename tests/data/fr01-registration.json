  "api_unique_then_duplicate": {
    "id": "FR01-TC12",
    "title": "unique-email registration followed by duplicate registration through the API.",
    "endpoint": "/api/register",
    "firstEmailReferenceToken": "{{firstGeneratedEmail}}",
    "records": [
      {
        "name": "first_unique_registration",
        "input": {
          "name": "Nguyễn Văn An",
          "emailTemplate": "fr01-tc12-{{unique}}@example.test",
          "password": "Abcdef1!"
        }
      },
      {
        "name": "second_duplicate_registration",
        "input": {
          "name": "Nguyễn Văn An Duplicate",
          "emailTemplate": "{{firstGeneratedEmail}}",
          "password": "Abcdef1!"
        }
      }
    ],
    "expected": {
      "first": {
        "status": 200,
        "message": "User registered successfully",
        "idType": "number"
      },
      "second": {
        "successful": false
      }
    }
  }
