  "confirmation_match_matrix": {
    "id": "FR01-TC11",
    "title": "confirmation equal-versus-unequal decision table and error placement.",
    "registrationPath": "/register",
    "fieldsToFill": [
      "fullName",
      "email",
      "password",
      "confirmationPassword"
    ],
    "rows": [
      {
        "name": "unequal",
        "passwordsMatch": false,
        "input": {
          "fullName": "Nguyễn Văn An",
          "emailTemplate": "fr01-tc11-unequal-{{unique}}@example.test",
          "password": "Abcdef1!",
          "confirmationPassword": "Abcdef1?"
        },
        "expected": {
          "registrationRequestCount": 0
        }
      },
      {
        "name": "equal",
        "passwordsMatch": true,
        "input": {
          "fullName": "Nguyễn Văn An",
          "emailTemplate": "fr01-tc11-equal-{{unique}}@example.test",
          "password": "Abcdef1!",
          "confirmationPassword": "Abcdef1!"
        },
        "expected": {
          "registrationRequestCount": 1
        }
      }
    ],
    "expected": {
      "labels": {
        "heading": "Đăng ký tài khoản",
        "fullName": "Họ Tên",
        "email": "Email",
        "password": "Mật khẩu",
        "confirmationPassword": "Xác nhận mật khẩu",
        "submit": "Đăng ký"
      },
      "confirmationControl": {
        "requiredAttribute": "",
